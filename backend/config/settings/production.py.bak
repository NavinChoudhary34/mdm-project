"""Production settings. Import everything from base and harden it."""
from decouple import config
from .base import *  # noqa: F401,F403

DEBUG = False

# --- HTTPS / cookie hardening ---
SECURE_SSL_REDIRECT = config('SECURE_SSL_REDIRECT', default=True, cast=bool)
SESSION_COOKIE_SECURE = True
CSRF_COOKIE_SECURE = True
SECURE_HSTS_SECONDS = 60 * 60 * 24 * 30  # 30 days
SECURE_HSTS_INCLUDE_SUBDOMAINS = True
SECURE_HSTS_PRELOAD = True
SECURE_CONTENT_TYPE_NOSNIFF = True
SECURE_BROWSER_XSS_FILTER = True
X_FRAME_OPTIONS = 'DENY'

# Only the JSON renderer in production — no browsable API exposing DB internals.
REST_FRAMEWORK['DEFAULT_RENDERER_CLASSES'] = (  # noqa: F405
    'rest_framework.renderers.JSONRenderer',
)

# --- Movie/poster file storage: Backblaze B2 (S3-compatible) ---
# Render's disk doesn't persist across deploys/restarts, so uploaded videos
# and posters can't live in the local filesystem here the way they do in
# dev. django-storages' S3-compatible backend works with B2 directly — B2
# just needs its own endpoint/region instead of AWS's.
STORAGES['default'] = {  # noqa: F405
    'BACKEND': 'storages.backends.s3.S3Storage',
}

AWS_ACCESS_KEY_ID = config('B2_KEY_ID')
AWS_SECRET_ACCESS_KEY = config('B2_APPLICATION_KEY')
AWS_STORAGE_BUCKET_NAME = config('B2_BUCKET_NAME')
AWS_S3_ENDPOINT_URL = config('B2_ENDPOINT_URL')  # e.g. https://s3.us-west-004.backblazeb2.com
AWS_S3_REGION_NAME = config('B2_REGION_NAME')  # e.g. us-west-004
AWS_S3_ADDRESSING_STYLE = 'virtual'
AWS_S3_FILE_OVERWRITE = False  # don't clobber a file if two uploads share a name

# The bucket stays private — the app already has a "private" vs "public"
# visibility concept for uploaded movies, so files shouldn't be publicly
# readable by anyone who has (or guesses) the URL. Instead every file URL
# is signed and expires, so a link only works briefly and only via a URL
# this app itself generated.
AWS_DEFAULT_ACL = None
AWS_QUERYSTRING_AUTH = True
AWS_QUERYSTRING_EXPIRE = 3600  # signed URLs expire after 1 hour
